; Keep npm's cache inside the project so installs work even when the user-level
; cache (%LOCALAPPDATA%\npm-cache) is locked down by an antivirus / sandbox.
cache=.npm-cache
fund=false
audit=false

; NOTE: electron's own download settings (ELECTRON_MIRROR,
; electron_config_cache) are NOT set here on purpose -- npm does not recognise
; those keys, warns about them on every command, and the warning on stderr
; aborts scripts that run with $ErrorActionPreference='Stop'.
; Set them as environment variables instead; see scripts/electron-install.ps1
; and scripts/pack.ps1.
